table 'Time Intelligence'
	calculationGroup
		precedence: 10

		calculationItem Current = IF(SELECTEDMEASURENAME() = "Revenue", SELECTEDMEASURE(), BLANK())

		calculationItem YTD = CALCULATE(IF(SELECTEDMEASURENAME() = "Revenue", SELECTEDMEASURE(), BLANK()), DATESYTD(Sales[Order Date]))
			formatStringDefinition = IF(SELECTEDMEASURENAME() = "Revenue", SELECTEDMEASUREFORMATSTRING(), "0") & " YTD"
			ordinal: 1

		calculationItem PY = CALCULATE(IF(SELECTEDMEASURENAME() = "Revenue", SELECTEDMEASURE(), BLANK()), SAMEPERIODLASTYEAR(Sales[Order Date]))
			ordinal: 2

	column Name
		dataType: string
		sourceColumn: Name
		sortByColumn: Ordinal

	column Ordinal
		dataType: int64
		isHidden
		sourceColumn: Ordinal

	partition 'Time Intelligence' = calculationGroup
		mode: import
		source = calculationGroup
